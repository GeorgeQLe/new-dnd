{
  "name": "kanban-dnd",
  "version": "1.0.0",
  "description": "A custom drag-and-drop library for React with ghost indicators, FLIP animations, and Kanban board support",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "react",
    "drag-and-drop",
    "dnd",
    "kanban",
    "sortable",
    "draggable",
    "droppable"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/GeorgeQLe/new-dnd.git",
    "directory": "packages/dnd"
  },
  "author": "George Le"
}
