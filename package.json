{
  "name": "kanban-dnd-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo for @kanban/dnd library and example application",
  "workspaces": [
    "packages/*",
    "example-dnd-app"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=example-dnd-app",
    "build": "npm run build --workspace=kanban-dnd",
    "build:app": "npm run build --workspace=example-dnd-app",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  }
}
